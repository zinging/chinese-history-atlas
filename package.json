{
  "name": "chinese-history-atlas",
  "version": "1.6.0",
  "private": true,
  "description": "中华历史图谱：纯静态国学可视化站点 + 零依赖本地 MCP Server（AI 讲解员）",
  "type": "module",
  "bin": {
    "chinese-history-atlas-mcp": "web/tools/history-mcp-server.mjs"
  },
  "scripts": {
    "start": "node web/serve.mjs",
    "build:search": "node scripts/build-search.mjs",
    "build:search:check": "node scripts/build-search.mjs --check",
    "build:myth": "node scripts/build-myth-schematic.mjs",
    "build:myth:check": "node scripts/build-myth-schematic.mjs --check",
    "build:emperors": "node scripts/build-emperors-bundle.mjs",
    "build:emperors:check": "node scripts/build-emperors-bundle.mjs --check",
    "verify:mobile": "node web/verify-mobile.mjs",
    "mcp": "node web/tools/history-mcp-server.mjs",
    "mcp:selftest": "node web/tools/history-mcp-server.mjs --selftest",
    "mcp:install": "powershell -ExecutionPolicy Bypass -File web/tools/install-mcp.ps1",
    "mcp:install:dsh": "node web/tools/install-dsh.mjs",
    "mcp:check:dsh": "node web/tools/install-dsh.mjs --check",
    "mcp:uninstall:dsh": "node web/tools/install-dsh.mjs --uninstall",
    "pack:plugin": "node web/tools/pack-plugin.mjs",
    "pack:plugin:check": "node web/tools/pack-plugin.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
