{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ming-journey/case.schema.json",
  "title": "明朝案件卡条目",
  "description": "案件是历史上有名的冤案/大案的展开版，供儿童交互层「案件卡」板块渲染。每个案件含背景、人物、过程、结果、影响五段。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "date", "summary", "nameOrigin", "background", "people", "process", "result", "impact", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^ming-case-[a-z0-9-]+$" },
    "name": { "type": "string", "description": "案件名，如 蓝玉案" },
    "category": { "type": "string", "description": "所属分类，如 明初四大案" },
    "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$", "description": "案发年份" },
    "summary": { "type": "string", "description": "一句话简述，小学生能懂，不超过 50 字" },
    "nameOrigin": { "type": "string", "description": "案件名怎么来的（孩子最常问的'为什么叫这个名字'）" },
    "background": { "type": "string", "description": "案件发生前的背景（为什么会有这件事）" },
    "people": {
      "type": "array",
      "description": "案件关键人物：皇帝、执法者、受害者、相关方",
      "items": {
        "type": "object",
        "required": ["name", "role", "note"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "description": "在此案中的角色，如 皇帝 / 主审官 / 行凶者" },
          "note": { "type": "string", "description": "一句说明，小学生能懂" }
        }
      }
    },
    "process": { "type": "string", "description": "案件经过（怎么发生的、怎么查的）" },
    "result": { "type": "string", "description": "案件结果（谁被判了什么、后来怎样）" },
    "impact": { "type": "string", "description": "案件影响（对当时和后世的影响）" },
    "openQuestions": {
      "type": "array",
      "description": "开放讨论题，无标准答案，每个含双视角",
      "items": {
        "type": "object",
        "required": ["question", "context", "viewpoints"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string" },
          "context": { "type": "string" },
          "viewpoints": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
